# Append these keys to the existing .env; do not replace database settings.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
# Composite Graph site ID: hostname,siteCollectionGuid,webGuid
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
# Existing folder item ID in the configured drive. Empty disables exports.
SHAREPOINT_EXPORT_FOLDER_ID=

# Optional department folders in the SAME drive; populated entries appear in destination selectors.
SHAREPOINT_FOLDER_ACCOUNT_ID=
SHAREPOINT_FOLDER_DCC_ID=
SHAREPOINT_FOLDER_ENVIRONMENT_ID=
SHAREPOINT_FOLDER_HR_ID=
SHAREPOINT_FOLDER_IT_ID=
SHAREPOINT_FOLDER_MAINTENANCE_ID=
SHAREPOINT_FOLDER_OPERATION_MARKETING_ID=
SHAREPOINT_FOLDER_PRODUCTION_ID=
SHAREPOINT_FOLDER_QC_ID=
SHAREPOINT_FOLDER_SUSTAINABILITY_ID=
