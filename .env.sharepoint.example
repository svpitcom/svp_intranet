# Append these keys to the existing .env; do not replace database settings.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
# Composite Graph site ID: hostname,siteCollectionGuid,webGuid
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
# Existing folder item ID in the configured drive. Empty disables exports.
SHAREPOINT_EXPORT_FOLDER_ID=
