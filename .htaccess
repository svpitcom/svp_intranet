# Serve the application from /svp_intranet without exposing project files.
Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:app|database|tests|vendor|docs|tmp|uploads)(?:/|$) - [F,L,NC]
RewriteRule ^public/uploads(?:/|$) - [F,L,NC]
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Public resources retain their existing URLs. Let public/.htaccess handle
# direct /public requests; never serve arbitrary repository files as static files.
RewriteRule ^public(?:/|$) - [L]
RewriteRule ^(assets|imgs)/(.*)$ public/$1/$2 [L]
RewriteRule ^index\.php$ - [L]
RewriteRule ^ index.php [L]
